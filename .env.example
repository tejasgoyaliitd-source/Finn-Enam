# Copy to .env (git-ignored). Used by tools/refresher and apps/api.
# Supabase project in ap-south-1 → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
# If SUPABASE_URL is missing, the refresher derives it from SUPABASE_JWKS_URL.
# Service role key: server-side only. Never ship it to the browser.
SUPABASE_SERVICE_KEY=

# 3-Step LLM Router Configuration & Failover Mapping: Gemini -> Groq -> Claude
# Primary Gemini Models:
#   Tier 1 (cheap):  gemini-3.1-flash-lite (unmatched filings, headlines, meeting dates, mandate tags)
#   Tier 2 (mid):    gemini-3.5-flash (transcript guidance, pdf results fallback, people profiles)
#   Tier 3 (strong): gemini-2.5-pro (downside risks, management questions, verdict pace notes)
# Groq Failover Models (active in account - 1st failover tier):
#   Tier 1 failover: openai/gpt-oss-20b (or qwen/qwen3.8-27b - fast & lightweight)
#   Tier 2 failover: openai/gpt-oss-120b (high reasoning & structured json)
#   Tier 3 failover: openai/gpt-oss-120b (high reasoning)
# Claude / Anthropic Failover Models (2nd failover tier if Groq fails or rate limits):
#   Across all tiers (cheap, mid, strong): haiku-5.5 (Claude 3.5 Haiku)
# Moderation filters (llama-prompt-guard, gpt-oss-safeguard) are explicitly ignored by router.
GEMINI_API_KEY=
GROQ_API_KEY=
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=
MODEL_CHEAP=gemini-3.1-flash-lite
MODEL_MID=gemini-3.5-flash
MODEL_STRONG=gemini-2.5-pro
MODEL_CHEAP_FAILOVER=openai/gpt-oss-20b
MODEL_MID_FAILOVER=openai/gpt-oss-120b
MODEL_STRONG_FAILOVER=openai/gpt-oss-120b
MODEL_CLAUDE_FAILOVER=haiku-5.5

{
  "name": "finn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @finn/api --filter @finn/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "refresh": "pnpm --filter @finn/refresher start",
    "test": "pnpm -r test",
    "test:failover": "pnpm --filter @finn/core test:failover",
    "smoke": "pnpm --filter @finn/refresher smoke"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "postgres": "^4.1.1",
    "typescript": "^5.9.3"
  }
}
